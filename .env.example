# OpenAI 兼容接口。默认 OpenRouter，可改成 DeepSeek 等。
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL=minimax/minimax-m3:free
LLM_FALLBACK_MODEL=minimax/minimax-m2.7:free

# 可选：首次启动默认城市
# BBPET_CITY=beijing
# BBPET_PUSH_INTERVAL=30

# 学校房主（也可在设置里勾选「我来当校长」）
# BBPET_ROOM_URL=ws://127.0.0.1:18765
# BBPET_HOST_ROOM=1
# BBPET_ROOM_PORT=18765
